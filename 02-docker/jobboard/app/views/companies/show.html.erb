<div class="max-w-3xl">
  <div class="bg-white border border-gray-200 rounded-lg p-8 mb-6">
    <div class="flex items-start justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @company.name %></h1>
        <p class="text-gray-500 mt-1"><%= @company.location %></p>
        <% if @company.website.present? %>
          <a href="<%= @company.website %>" target="_blank"
             class="text-blue-600 hover:underline text-sm mt-1 inline-block">
            <%= @company.website %>
          </a>
        <% end %>
      </div>
      <% if user_signed_in? && @company.user == current_user %>
        <%= link_to "Edit Company", edit_company_path(@company),
            class: "text-sm border border-gray-300 px-3 py-1 rounded hover:bg-gray-50" %>
      <% end %>
    </div>
    <% if @company.description.present? %>
      <p class="mt-4 text-gray-700"><%= @company.description %></p>
    <% end %>
  </div>

  <h2 class="text-lg font-semibold text-gray-800 mb-4">Open Positions (<%= @jobs.count %>)</h2>
  <% if @jobs.any? %>
    <div class="space-y-3">
      <% @jobs.each do |job| %>
        <div class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-sm">
          <%= link_to job.title, job_path(job), class: "font-medium text-blue-700 hover:text-blue-900" %>
          <span class="text-gray-500 text-sm ml-2"><%= job.location %></span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 text-sm">No open positions at this time.</p>
  <% end %>
</div>
