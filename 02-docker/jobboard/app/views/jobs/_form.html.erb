<%= form_with model: job, local: true, class: "space-y-5" do |f| %>
  <% if job.errors.any? %>
    <div class="bg-red-50 border border-red-300 rounded p-4 text-sm text-red-700">
      <p class="font-medium mb-1">Please fix the following errors:</p>
      <ul class="list-disc pl-5">
        <% job.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Job Title", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :title, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400", placeholder: "e.g. Senior Rails Developer" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :location, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :location, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400", placeholder: "e.g. Remote, New York" %>
    </div>
    <div>
      <%= f.label :job_type, "Job Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :job_type, ["Full-time", "Part-time", "Contract", "Internship"],
          { include_blank: "Select type" },
          class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :salary_min, "Salary Min ($)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :salary_min, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400", placeholder: "80000" %>
    </div>
    <div>
      <%= f.label :salary_max, "Salary Max ($)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :salary_max, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400", placeholder: "120000" %>
    </div>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :description, rows: 10,
        class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400",
        placeholder: "Describe the role, requirements, and what makes it exciting..." %>
  </div>

  <%= f.submit job.persisted? ? "Update Job" : "Post Job",
      class: "bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 cursor-pointer font-medium" %>
<% end %>
