<div class="mb-4">
  <%= link_to "← Back to Job", employer_job_path(@application.job), class: "text-blue-600 hover:underline text-sm" %>
</div>

<div class="max-w-2xl">
  <div class="bg-white border border-gray-200 rounded-lg p-6 mb-5">
    <h1 class="text-xl font-bold text-gray-800 mb-1">Application from <%= @application.user.email %></h1>
    <p class="text-sm text-gray-500 mb-5">
      Applied <%= @application.created_at.strftime("%B %d, %Y") %> &bull;
      Status: <%= status_badge(@application.status) %>
    </p>

    <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-2">Cover Letter</h2>
    <div class="text-gray-700 whitespace-pre-wrap text-sm bg-gray-50 rounded p-4">
      <%= @application.cover_letter %>
    </div>

    <% if @application.resume.attached? %>
      <div class="mt-4">
        <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-2">Resume</h2>
        <%= link_to "Download Resume", rails_blob_path(@application.resume, disposition: :attachment),
            class: "text-blue-600 hover:underline text-sm" %>
      </div>
    <% end %>
  </div>

  <%# Status Update Controls %>
  <div class="bg-white border border-gray-200 rounded-lg p-5">
    <h2 class="font-semibold text-gray-700 mb-3">Update Status</h2>
    <div class="flex gap-2 flex-wrap">
      <% JobApplication.statuses.keys.each do |s| %>
        <%= button_to s.capitalize,
            update_status_employer_job_application_path(@application.job, @application),
            params: { status: s },
            method: :patch,
            class: "px-4 py-2 rounded text-sm font-medium border #{ @application.status == s ? 'bg-blue-600 text-white border-blue-600' : 'border-gray-300 hover:bg-gray-50' }" %>
      <% end %>
    </div>
  </div>
</div>
