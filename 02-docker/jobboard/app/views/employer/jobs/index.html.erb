<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-800">Your Job Postings</h1>
  <% if current_user.company %>
    <%= link_to "Post a Job", new_job_path,
        class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
  <% end %>
</div>

<% unless current_user.company %>
  <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-5 mb-6">
    <p class="text-yellow-800">Set up your company profile before posting jobs.</p>
    <%= link_to "Create Company Profile →", new_company_path,
        class: "text-blue-600 hover:underline mt-2 inline-block font-medium" %>
  </div>
<% end %>

<% if @jobs.any? %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-5 py-3 text-left font-medium text-gray-600">Title</th>
          <th class="px-5 py-3 text-left font-medium text-gray-600">Location</th>
          <th class="px-5 py-3 text-left font-medium text-gray-600">Applications</th>
          <th class="px-5 py-3 text-left font-medium text-gray-600">Posted</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @jobs.each do |job| %>
          <tr class="hover:bg-gray-50">
            <td class="px-5 py-3">
              <%= link_to job.title, employer_job_path(job), class: "text-blue-600 hover:underline font-medium" %>
            </td>
            <td class="px-5 py-3 text-gray-600"><%= job.location %></td>
            <td class="px-5 py-3 text-gray-600"><%= job.job_applications.size %></td>
            <td class="px-5 py-3 text-gray-500"><%= job.created_at.strftime("%b %d, %Y") %></td>
            <td class="px-5 py-3">
              <%= link_to "Edit", edit_job_path(job), class: "text-blue-600 hover:underline text-xs mr-2" %>
              <%= link_to "Delete", job_path(job), data: { turbo_method: :delete, turbo_confirm: "Delete this job?" },
                  class: "text-red-600 hover:underline text-xs" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% elsif current_user.company %>
  <div class="text-center py-16 text-gray-500">
    <p class="text-lg mb-3">No jobs posted yet.</p>
    <%= link_to "Post your first job →", new_job_path, class: "text-blue-600 hover:underline" %>
  </div>
<% end %>
