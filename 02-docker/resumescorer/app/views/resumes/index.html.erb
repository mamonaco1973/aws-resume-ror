<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-800">My Resumes</h1>
  <%= link_to "Upload Resume", new_resume_path,
      class: "bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 text-sm font-medium" %>
</div>

<% if @resumes.any? %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-5 py-3 text-left font-medium text-gray-600">Name</th>
          <th class="px-5 py-3 text-left font-medium text-gray-600">File</th>
          <th class="px-5 py-3 text-left font-medium text-gray-600">Text Extracted</th>
          <th class="px-5 py-3 text-left font-medium text-gray-600">Uploaded</th>
          <th class="px-5 py-3 w-16"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @resumes.each do |resume| %>
          <tr class="hover:bg-gray-50">
            <td class="px-5 py-3 font-medium text-gray-800">
              <%= link_to resume.name, resume_path(resume),
                  class: "text-indigo-600 hover:underline" %>
            </td>
            <td class="px-5 py-3">
              <% if resume.file.attached? %>
                <%= link_to resume.file.filename,
                    rails_blob_path(resume.file, disposition: "attachment"),
                    class: "text-indigo-600 hover:underline" %>
              <% else %>
                <span class="text-gray-400 text-xs">No file</span>
              <% end %>
            </td>
            <td class="px-5 py-3">
              <% if resume.content_text.present? %>
                <span class="text-green-600 text-xs font-medium">Yes
                  (<%= resume.content_text.length %> chars)</span>
              <% else %>
                <span class="text-gray-400 text-xs">No text</span>
              <% end %>
            </td>
            <td class="px-5 py-3 text-gray-500 text-xs">
              <%= resume.created_at.strftime("%b %d, %Y") %>
            </td>
            <td class="px-5 py-3 text-right">
              <%= link_to "Delete", resume_path(resume),
                  data: { turbo_method: :delete, turbo_confirm: "Delete this resume?" },
                  class: "text-xs text-red-500 hover:text-red-700" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="text-center py-16 text-gray-500">
    <p class="text-lg mb-3">No resumes uploaded yet.</p>
    <%= link_to "Upload your first resume →", new_resume_path,
        class: "text-indigo-600 hover:underline" %>
  </div>
<% end %>
