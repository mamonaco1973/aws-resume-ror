<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Resume Scorer</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="csrf-param" content="<%= request_forgery_protection_token %>">
    <meta name="csrf-token" content="<%= form_authenticity_token %>">
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-50 min-h-screen">

    <nav class="bg-indigo-700 text-white shadow-md">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="<%= root_path %>" class="text-xl font-bold tracking-tight">Resume Scorer</a>
        <div class="flex items-center gap-4 text-sm">
          <% if user_signed_in? %>
            <a href="<%= root_path %>"       class="hover:text-indigo-200">Dashboard</a>
            <a href="<%= resumes_path %>"    class="hover:text-indigo-200">Resumes</a>
            <a href="<%= folders_path %>"    class="hover:text-indigo-200">Folders</a>
            <a href="<%= new_job_path %>"    class="hover:text-indigo-200">Score a Job</a>
            <span class="text-indigo-300 text-xs"><%= current_user.email %></span>
            <%= link_to "Sign out", destroy_user_session_path,
                class: "bg-white text-indigo-700 px-3 py-1 rounded hover:bg-indigo-50 text-xs" %>
          <% else %>
            <%= link_to "Sign in",  new_user_session_path,      class: "hover:text-indigo-200" %>
            <%= link_to "Sign up",  new_user_registration_path,
                class: "bg-white text-indigo-700 px-3 py-1 rounded hover:bg-indigo-50" %>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="max-w-6xl mx-auto px-4 mt-4">
      <% flash.each do |type, message| %>
        <% css = type.to_s == "alert" ? "bg-red-50 border-red-300 text-red-800" : "bg-green-50 border-green-300 text-green-800" %>
        <div class="border rounded px-4 py-3 mb-4 <%= css %>"><%= message %></div>
      <% end %>
    </div>

    <main class="max-w-6xl mx-auto px-4 py-6">
      <%= yield %>
    </main>

  </body>
</html>
